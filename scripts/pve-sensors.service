[Unit]
Description=PVE Sensors API (hardened launcher)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/default/pve-sensors
ExecStart=/usr/bin/python3 /usr/local/bin/pve-sensors-secure.py
Restart=always
RestartSec=10s

# Runs as root: dmidecode/smartctl need it. Conservative hardening; the
# script is read-only, so it needs no write access to the system.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=multi-user.target
